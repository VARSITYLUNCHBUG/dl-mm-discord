# Copy to .env and fill in. Never commit .env.

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Django
DJANGO_SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
# Set both if the admin sits behind a TLS reverse proxy. Without TLS, set SECURE_COOKIES=false.
# BEHIND_TLS_PROXY=true
SECURE_COOKIES=false

# Database. Compose overrides the host for its own containers.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://draftbot:change-me@127.0.0.1:55432/draftbot

LOG_LEVEL=INFO

# Local smoke tests only: DEBUG=true and DEV_FAKE_PLAYERS=true enable `manage.py dev_fill_queue`.
DEV_FAKE_PLAYERS=false
